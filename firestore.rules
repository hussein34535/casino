rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /questions/{question} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    match /games/{game} {
      // Anyone authenticated can see rooms waiting for players (lobby browser).
      // Members (host or joined players) can read at any stage via playerIds.
      allow read: if request.auth != null && (
        resource.data.status == 'waiting' ||
        request.auth.uid == resource.data.hostId ||
        request.auth.uid in resource.data.playerIds
      );
      allow create: if request.auth != null;
      // Host and members can update anything; outsiders may only
      // join a waiting room (touch players/playerIds and nothing else).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.hostId ||
        request.auth.uid in resource.data.playerIds ||
        (resource.data.status == 'waiting' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['players', 'playerIds']))
      );
      allow delete: if false;
    }
    match /friends/{friend} {
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.friendId);
    }
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /achievements/{achievement} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    match /streaks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /shopItems/{item} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    match /challenges/{challenge} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
